# Copy this file to LavaLust/.env (same folder as the "lava" file) and fill in the values.
# NEVER commit the real .env file.

APP_NAME=Lavalust
APP_ENV=development
# Generate one with:  php lava key:generate
APP_KEY=

# Aiven MySQL (Console -> your service -> Overview -> Connection information)
DB_HOST=
DB_PORT=
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
DB_SSL=true
# Local machine only: path to the CA certificate downloaded from Aiven (ca.pem).
# On Render (Docker/Debian) leave empty, the system CA bundle is used.
DB_SSL_CA=

# JWT (optional - if empty they are derived from APP_KEY)
JWT_SECRET=
REFRESH_TOKEN_KEY=
JWT_EXPIRATION=3600

# Comma-separated list of allowed frontend origins. Use * only for local testing.
ALLOW_ORIGIN=*

# Allow migrations (CLI + /migrate routes). true on your PC, leave UNSET on Render.
MIGRATION_ENABLED=true
